# Local example only. Copy to .env and replace the placeholder password.
# Export DATABASE_URL into your terminal before running the ETL or Uvicorn.
# Python modules do not automatically load .env; see README.md for commands.
# Percent-encode reserved characters in URL usernames/passwords (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/weather_analytics

# For a remote provider, append ?sslmode=require (and its recommended options).
# GitHub Actions instead constructs DATABASE_URL from these Repository Secrets:
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME.
# Set those secrets in GitHub Settings, not in this file. Supply raw, unencoded
# DB_USER and DB_PASSWORD secrets; the CI helper encodes them safely.
